# ═══════════════════════════════════════════════════════════════════════════════
# OceanBazar — Production Environment Variables
# Copy this to .env in the project root before running docker compose.
# All variables with defaults will use the default if left empty.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=oceanbazar
POSTGRES_USER=oceanbazar
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST_PORT=5433

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST_PORT=6399

# ─── Node.js BFF ──────────────────────────────────────────────────────────────
NODE_ENV=production
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_SECRET_KEY=CHANGE_ME_JAVA_JWT_SECRET_KEY
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
OTP_TERMINAL_ONLY=false
CLIENT_URL=https://oceanbazar.com.bd
ADMIN_URL=https://admin.oceanbazar.com.bd
BFF_PUBLIC_BASE_URL=https://api.oceanbazar.com.bd
TRUST_PROXY=1

# ─── Java API ─────────────────────────────────────────────────────────────────
JAVA_PUBLIC_BASE_URL=https://api.oceanbazar.com.bd
CORS_ALLOWED_ORIGINS=https://oceanbazar.com.bd,https://admin.oceanbazar.com.bd,https://contentid.oceanbazar.com.bd

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_production_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="OceanBazar <noreply@oceanbazar.com>"

# ─── SMS ──────────────────────────────────────────────────────────────────────
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_production_sid
TWILIO_AUTH_TOKEN=your_production_token
TWILIO_FROM_NUMBER=+880XXXXXXXXXX

# ─── Firebase Auth ────────────────────────────────────────────────────────────
FIREBASE_API_KEY=AIzaSyAsLuUVSdDRgynoSJIx3jOJgkQgGUevg3w
FIREBASE_PROJECT_ID=oceanbazarbd

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=dmtafp1fi
CLOUDINARY_API_KEY=487252925521551
CLOUDINARY_API_SECRET=_rHB9A85bxjgZqzcNZb0ja9vBk8

# ─── Pathao Courier (production) ──────────────────────────────────────────────
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=your_production_pathao_client_id
PATHAO_CLIENT_SECRET=your_production_pathao_client_secret
PATHAO_USERNAME=your_production_pathao_username
PATHAO_PASSWORD=your_production_pathao_password
PATHAO_STORE_ID=your_approved_store_id

# ─── Steadfast Courier ───────────────────────────────────────────────────────
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
STEADFAST_WEBHOOK_TOKEN=generate_a_long_random_bearer_token

# ─── Paperfly Courier ────────────────────────────────────────────────────────
PAPERFLY_USERNAME=c177020
PAPERFLY_PASSWORD=5710
PAPERFLY_KEY=Paperfly_~La?Rj73FcLm

# ─── Payments (production) ───────────────────────────────────────────────────
BKASH_APP_KEY=your_production_bkash_key
BKASH_APP_SECRET=your_production_bkash_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_KEY=your_nagad_merchant_key
NAGAD_BASE_URL=https://api.mynagad.com/remote-payment-gateway-1.0

SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_SANDBOX=false
API_BASE_URL=https://api.oceanbazar.com.bd

# ─── Microsoft Graph mail ─────────────────────────────────────────────────────
MS_TENANT_ID=your_tenant_id
MS_CLIENT_ID=your_graph_mail_app_client_id
MS_CLIENT_SECRET=your_graph_mail_app_secret
MS_SENDER_ADDRESSES=no-reply@oceanbazar.com.bd,contact@oceanbazar.com.bd,business@oceanbazar.com.bd
MS_DEFAULT_SENDER=no-reply@oceanbazar.com.bd
MS_SUPPORT_SENDER=contact@oceanbazar.com.bd

# ─── Meta Business / WhatsApp ─────────────────────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=generate_a_long_random_verify_token
META_PAGE_ID=your_page_id
META_IG_ID=your_instagram_account_id
META_AD_ACCOUNT_ID=your_ad_account_id
META_OAUTH_REDIRECT_URI=https://api.oceanbazar.com.bd/api/admin/meta/oauth/callback
META_OAUTH_ALLOWED_HOSTS=api.oceanbazar.com.bd,api.oceanbazar.com
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# ─── Content ID (contentid.oceanbazar.com.bd) ────────────────────────────────
CONTENT_ID_APP_URL=https://contentid.oceanbazar.com.bd
MS_CONTENT_ID_REDIRECT_URI=https://api.oceanbazar.com.bd/api/content-id/auth/sso/microsoft/callback

# ─── Frontend (build-time) ───────────────────────────────────────────────────
# Hetzner: API on api subdomain (nginx → BFF). Do NOT point API URL at the storefront host.
NEXT_PUBLIC_API_URL=https://api.oceanbazar.com.bd
NEXT_PUBLIC_ADMIN_CRM_URL=https://admin.oceanbazar.com.bd
NEXT_PUBLIC_SITE_URL=https://oceanbazar.com.bd
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAsLuUVSdDRgynoSJIx3jOJgkQgGUevg3w
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=oceanbazarbd.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=oceanbazarbd
NEXT_PUBLIC_FIREBASE_APP_ID=1:749559457588:web:f67ca8249309c0887ae761
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id

# ─── Admin CRM (build-time) ──────────────────────────────────────────────────
VITE_ADMIN_API_URL=https://admin.oceanbazar.com.bd

# ─── BFF background workers (runtime) ───────────────────────────────────────
# Set to "false" to disable without redeploying code
ANALYTICS_CRON=true
EVENT_DLQ_CRON=true
# Alias for EVENT_DLQ_CRON (DLQ_WORKER=false disables the retry worker)
DLQ_WORKER=true
EVENT_DLQ_POLL_MS=300000
EVENT_DLQ_BATCH=25
ANALYTICS_NIGHTLY_HOUR=2

# ─── Global maintenance lock (copy from config/maintenance.env via sync script) ─
MAINTENANCE_MODE=true
MAINTENANCE_BYPASS_TOKEN=CHANGE_ME_run_node_scripts_sync-maintenance-env_mjs
MAINTENANCE_RETRY_AFTER=3600
MAINTENANCE_COOKIE_DOMAIN=.oceanbazar.com.bd
MAINTENANCE_ALLOW_HEALTH_PROBE=true
VITE_MAINTENANCE_MODE=true
VITE_MAINTENANCE_BYPASS_TOKEN=CHANGE_ME_same_as_above
VITE_MAINTENANCE_COOKIE_DOMAIN=.oceanbazar.com.bd
VITE_MAINTENANCE_PAGE_URL=https://oceanbazar.com.bd/en/maintenance
