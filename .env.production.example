# ═══════════════════════════════════════════════════════════════════════════════
# OceanBazar — Production Environment Variables
# Copy this to .env in the project root before running docker compose.
# All variables with defaults will use the default if left empty.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=oceanbazar
POSTGRES_USER=oceanbazar
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST_PORT=5433

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST_PORT=6399

# ─── Node.js BFF ──────────────────────────────────────────────────────────────
NODE_ENV=production
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_SECRET_KEY=CHANGE_ME_JAVA_JWT_SECRET_KEY
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
OTP_TERMINAL_ONLY=false
CLIENT_URL=https://oceanbazar.com
ADMIN_URL=https://admin.oceanbazar.com
BFF_PUBLIC_BASE_URL=https://oceanbazar.com

# ─── Java API ─────────────────────────────────────────────────────────────────
JAVA_PUBLIC_BASE_URL=https://oceanbazar.com
CORS_ALLOWED_ORIGINS=https://oceanbazar.com,https://admin.oceanbazar.com

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_production_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="OceanBazar <noreply@oceanbazar.com>"

# ─── SMS ──────────────────────────────────────────────────────────────────────
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_production_sid
TWILIO_AUTH_TOKEN=your_production_token
TWILIO_FROM_NUMBER=+880XXXXXXXXXX

