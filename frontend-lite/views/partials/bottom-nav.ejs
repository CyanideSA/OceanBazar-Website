<%
  var bnPath = String(typeof path !== 'undefined' ? path : '');
  var bnHome = '/' + locale;
  var bnProducts = '/' + locale + '/products';
  var bnChat = '/' + locale + '/chat';
  var bnAccount = user ? ('/' + locale + '/account') : ('/' + locale + '/auth/login');
  var isHome = bnPath === bnHome || bnPath === bnHome + '/';
  var isProducts = bnPath.indexOf(bnProducts) === 0;
  var isChat = bnPath.indexOf('/chat') !== -1;
  var isAccount = bnPath.indexOf('/account') !== -1 || bnPath.indexOf('/auth/') !== -1;
%>
<nav class="bottom-nav" aria-label="<%= t('shop') %>">
  <a class="bottom-nav-item<%= isHome ? ' is-active' : '' %>" href="<%= basePath %><%= bnHome %>">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3 2 12h3v8h6v-5h2v5h6v-8h3L12 3z"/></svg>
    <span><%= t('home') %></span>
  </a>
  <a class="bottom-nav-item<%= isProducts ? ' is-active' : '' %>" href="<%= basePath %><%= bnProducts %>">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z"/></svg>
    <span><%= t('products') %></span>
  </a>
  <a class="bottom-nav-item<%= isChat ? ' is-active' : '' %>" href="<%= basePath %><%= bnChat %>">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-4 3v-3H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
    <span><%= t('liveChat') %></span>
  </a>
  <a class="bottom-nav-item<%= isAccount ? ' is-active' : '' %>" href="<%= basePath %><%= bnAccount %>">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5z"/></svg>
    <span><%= t('account') %></span>
  </a>
</nav>
