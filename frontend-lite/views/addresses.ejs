<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="section narrow">
  <h1><%= t('addresses') %></h1>
  <% if (!addresses.length) { %>
  <p class="empty"><%= t('noAddresses') %></p>
  <% } else { %>
  <ul class="menu-list">
    <% addresses.forEach(function(addr) { %>
    <li>
      <strong><%= addr.name || '' %></strong> · <%= addr.phone || '' %><br />
      <%= addr.addressLine1 || addr.address || '' %>, <%= addr.area || '' %>, <%= addr.city || '' %>
      <% if (addr.isDefault) { %> <em>(<%= t('default') %>)</em><% } %>
    </li>
    <% }) %>
  </ul>
  <% } %>

  <h2><%= t('addAddress') %></h2>
  <form method="post" action="/<%= locale %>/account/addresses" class="stack">
    <label class="field"><span><%= t('name') %></span><input name="name" required /></label>
    <label class="field"><span><%= t('phone') %></span><input name="phone" required /></label>
    <label class="field"><span><%= t('addressLine') %></span><input name="addressLine" required /></label>
    <label class="field"><span><%= t('area') %></span><input name="area" /></label>
    <label class="field"><span><%= t('city') %></span><input name="city" required /></label>
    <label class="field"><span><%= t('district') %></span><input name="district" /></label>
    <label class="field"><span><%= t('postalCode') %></span><input name="postalCode" /></label>
    <label><input type="checkbox" name="isDefault" value="1" /> <%= t('default') %></label>
    <button type="submit" class="btn btn-primary"><%= t('save') %></button>
  </form>
</section>

<%- include('partials/footer') %>
