<%- include('partials/head') %>

<%
  var items = order.items || order.orderItems || [];
  var paid = String(order.paymentStatus || '').toLowerCase() === 'paid'
    || String(order.paymentStatus || '').toLowerCase() === 'completed'
    || String(order.paymentStatus || '').toLowerCase() === 'success';
  var created = order.createdAt || order.created_at;
  var addr = order.shippingAddress || order.address || null;
  var cust = order.customer || {};
  var billName = cust.name || (addr && addr.name) || 'Customer';
  var billEmail = cust.email || '';
  var billPhone = cust.phone || (addr && addr.phone) || '';
  var num = function (v) { return Number(v || 0); };
  var logo = (settings && (settings.logoLightUrl || settings.logoDarkUrl))
    ? (settings.logoLightUrl || settings.logoDarkUrl)
    : (basePath + '/ob-brand-logo.png?v=10');
  function pretty(v) {
    var s = String(v || '').trim().toLowerCase().replace(/_/g, ' ');
    if (!s) return '—';
    return s.replace(/\b\w/g, function (c) { return c.toUpperCase(); });
  }
  // t() echoes the key back when a translation is missing — fall back to real copy instead.
  var tv = function (key, fallback) { var s = t(key); return !s || s === key ? fallback : s; };
  var supportEmail = (settings && settings.supportEmail) || 'contact@oceanbazar.com.bd';
  var supportPhone = (settings && settings.supportPhone) || '+880 1349 358 825';
  var grossItems = num(order.subtotal);
  var invDiscount = num(order.discount);
  var invVat = num(order.gst);
  var invShipping = num(order.shippingFee);
  var invLegacyService = num(order.serviceFee);
  var invTotal = num(order.total || order.grandTotal);
  var invNetOfFees = grossItems - invDiscount + invShipping + invLegacyService;
  // Orders placed before VAT-inclusive pricing added VAT on top; detect which model applies.
  var invVatInclusive = Math.abs(invNetOfFees - invTotal) <= Math.abs(invNetOfFees + invVat - invTotal);
  var invSubtotalExclVat = invVatInclusive ? grossItems - invDiscount - invVat : grossItems - invDiscount;
  var invVatPct = invSubtotalExclVat > 0 ? (invVat / invSubtotalExclVat) * 100 : 0;
  var invVatLabel = Number.isInteger(invVatPct) ? String(invVatPct) : invVatPct.toFixed(1);
%>

<style>
  @media print {
    .site-header, .drawer, .nav-drawer, .nav-backdrop, .site-footer, .flash-bar, .no-print, #menuBtn, .bottom-nav { display: none !important; }
    html, body { background: #fff !important; margin: 0 !important; padding: 0 !important; height: auto !important; min-height: 0 !important; }
    body * { visibility: hidden !important; }
    #ob-invoice, #ob-invoice * { visibility: visible !important; }
    #ob-invoice {
      position: absolute !important; left: 0; top: 0; width: 100%; max-width: none !important;
      margin: 0; padding: 0; font-size: 10.5px; line-height: 1.35;
      transform: scale(var(--print-scale, 1)); transform-origin: top left;
    }
    #ob-invoice table { font-size: 10px; page-break-inside: auto; }
    #ob-invoice tr, #ob-invoice thead, #ob-invoice tfoot { page-break-inside: avoid; break-inside: avoid; }
    #ob-invoice .inv-head, #ob-invoice .inv-grid, #ob-invoice .inv-totals, #ob-invoice .inv-foot {
      page-break-inside: avoid; break-inside: avoid;
    }
    #ob-invoice .inv-table { margin-top: 10px; }
    #ob-invoice .inv-foot { margin-top: 12px; padding-top: 8px; }
    #ob-invoice img { height: 36px; width: auto; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
  @page { size: A4; margin: 8mm; }
  .invoice-toolbar { display: flex; justify-content: flex-end; gap: 10px; padding: 12px 16px; background: #f9fafb; border-bottom: 1px solid #e5e7eb; }
  #ob-invoice { max-width: 720px; margin: 0 auto; padding: 28px 24px; background: #fff; color: #1f2937; font-family: system-ui, sans-serif; }
  .inv-head { display: flex; justify-content: space-between; gap: 16px; border-bottom: 1px solid #e5e7eb; padding-bottom: 14px; }
  .inv-logo { height: 48px; width: auto; object-fit: contain; }
  .inv-meta { text-align: right; }
  .inv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px; }
  .inv-label { font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #9ca3af; }
  .inv-table { width: 100%; border-collapse: collapse; margin-top: 18px; font-size: 13px; }
  .inv-table th { background: #2E7CF6; color: #fff; padding: 8px 10px; text-align: left; }
  .inv-table th:nth-child(2) { text-align: center; }
  .inv-table th:nth-child(3), .inv-table th:nth-child(4) { text-align: right; }
  .inv-table td { padding: 6px 10px; border-bottom: 1px solid #f3f4f6; }
  .inv-table tr:nth-child(even) { background: #f9fafb; }
  .inv-totals { margin-top: 14px; margin-left: auto; width: 240px; font-size: 13px; }
  .inv-totals div { display: flex; justify-content: space-between; padding: 3px 0; color: #4b5563; }
  .inv-totals .grand { border-top: 1px solid #d1d5db; margin-top: 6px; padding-top: 8px; font-weight: 700; color: #111827; font-size: 15px; }
  .inv-totals .grand span:last-child { color: #2E7CF6; }
  .inv-foot { margin-top: 22px; border-top: 1px solid #e5e7eb; padding-top: 12px; text-align: center; font-size: 11px; color: #9ca3af; }
  .pill-inv { display: inline-block; border-radius: 999px; padding: 2px 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; }
  .pill-paid { background: #dcfce7; color: #15803d; }
  .pill-pend { background: #fef3c7; color: #92400e; }
  .pill-status { background: rgba(46,124,246,.12); color: #2E7CF6; }
</style>

<div class="invoice-toolbar no-print">
  <button type="button" id="invoicePrintBtn" class="btn btn-primary btn-sm"><%= t('printInvoice') %></button>
  <a class="btn btn-outline btn-sm" href="<%= basePath %>/<%= locale %>/account/orders/<%= order.id %>">&larr; <%= t('orders') %></a>
</div>

<div id="ob-invoice">
  <div class="inv-head">
    <div>
      <img class="inv-logo" src="<%= logo %>" alt="OceanBazar" width="168" height="56" />
      <p class="muted" style="margin:8px 0 0;font-size:12px;font-weight:600;"><%= (settings && settings.legalName) || 'Ocean Bazar' %></p>
      <p class="muted" style="margin:0;font-size:12px;"><%= (settings && settings.registeredAddress) || (settings && settings.contactAddress) || '' %></p>
      <p class="muted" style="margin:0;font-size:12px;"><%= supportEmail %> · <%= supportPhone %></p>
      <% if (settings && (settings.tradeLicenseNo || settings.tinNumber)) { %>
      <p class="muted" style="margin:4px 0 0;font-size:11px;">
        <% if (settings.tradeLicenseNo) { %>Trade license: <%= settings.tradeLicenseNo %><% } %>
        <% if (settings.tradeLicenseNo && settings.tinNumber) { %> · <% } %>
        <% if (settings.tinNumber) { %>TIN: <%= settings.tinNumber %><% } %>
      </p>
      <% } %>
      <p class="muted" style="margin:4px 0 0;font-size:12px;">oceanbazar.com.bd</p>
    </div>
    <div class="inv-meta">
      <h1 style="margin:0;font-size:22px;letter-spacing:.04em;"><%= t('invoice') %></h1>
      <p style="margin:6px 0 0;font-weight:600;">#<%= order.orderNumber || order.id %></p>
      <% if (created) { %>
      <p class="muted" style="margin:4px 0 0;font-size:12px;"><%= t('orderDate') %>: <%= new Date(created).toLocaleDateString(locale === 'bn' ? 'bn-BD' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
      <% } %>
      <p style="margin:8px 0 0;">
        <span class="pill-inv <%= paid ? 'pill-paid' : 'pill-pend' %>"><%= paid ? t('paid') : pretty(order.paymentStatus) %></span>
        <span class="pill-inv pill-status"><%= pretty(order.status) %></span>
      </p>
    </div>
  </div>

  <div class="inv-grid">
    <div>
      <p class="inv-label"><%= t('billTo') %></p>
      <p style="margin:6px 0 0;font-weight:600;"><%= billName %></p>
      <% if (billEmail) { %><p style="margin:2px 0;font-size:13px;"><%= billEmail %></p><% } %>
      <% if (billPhone) { %><p style="margin:2px 0;font-size:13px;"><%= billPhone %></p><% } %>
      <% if (addr) { %>
      <p style="margin:8px 0 0;font-size:13px;"><%= addr.addressLine1 || addr.addressLine || '' %></p>
      <p style="margin:2px 0;font-size:13px;"><%= [addr.city, addr.district].filter(Boolean).join(', ') %></p>
      <% if (addr.country) { %><p style="margin:2px 0;font-size:13px;"><%= addr.country %></p><% } %>
      <% } %>
    </div>
    <div>
      <p class="inv-label"><%= t('paymentMethod') %></p>
      <p style="margin:6px 0 0;font-weight:600;"><%= pretty(order.paymentMethod) %></p>
      <p class="inv-label" style="margin-top:12px;"><%= t('paymentStatus') %></p>
      <p style="margin:6px 0 0;font-weight:600;"><%= pretty(order.paymentStatus) %></p>
    </div>
  </div>

  <% if (items.length) { %>
  <table class="inv-table">
    <thead>
      <tr>
        <th><%= t('product') || 'Product' %></th>
        <th style="text-align:center;">Qty</th>
        <th style="text-align:right;">Unit</th>
        <th style="text-align:right;"><%= t('total') %></th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function (it) {
        var nm = it.productTitle || it.productName || it.name || it.productId;
        var vlabel = it.variantLabel || it.variant_label || '';
        var qty = num(it.quantity || 1);
        var unit = num(it.unitPrice != null ? it.unitPrice : it.price);
        var line = num(it.lineTotal != null ? it.lineTotal : unit * qty);
      %>
      <tr>
        <td>
          <%= nm %>
          <% if (vlabel) { %><div style="font-size:12px;color:#64748b;margin-top:2px;"><%= vlabel %></div><% } %>
        </td>
        <td style="text-align:center;"><%= qty %></td>
        <td style="text-align:right;"><%= helpers.money(unit) %></td>
        <td style="text-align:right;font-weight:600;"><%= helpers.money(line) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>

  <div class="inv-totals">
    <% if (invDiscount > 0) { %>
    <div><span><%= tv('lineItemsGross', 'Items (incl. VAT)') %></span><span><%= helpers.money(grossItems) %></span></div>
    <div style="color:#16a34a;"><span><%= t('discount') %></span><span>-<%= helpers.money(invDiscount) %></span></div>
    <% } %>
    <div><span><%= tv('lineMerchandise', 'Subtotal (excl. VAT)') %></span><span><%= helpers.money(invSubtotalExclVat) %></span></div>
    <% if (invVat > 0) { %><div><span><%= t('vat') %> (<%= invVatLabel %>%)</span><span><%= helpers.money(invVat) %></span></div><% } %>
    <div><span><%= t('shipping') %></span><span><%= invShipping === 0 ? t('trustShip') : helpers.money(invShipping) %></span></div>
    <div class="grand"><span><%= tv('totalDue', t('total')) %></span><span><%= helpers.money(invTotal) %></span></div>
    <% if (invVat > 0) { %>
    <p class="muted" style="margin:6px 0 0;font-size:10px;line-height:1.3;">
      Item prices include <%= invVatLabel %>% VAT<% if (settings && settings.tinNumber) { %> · VAT registration TIN: <%= settings.tinNumber %><% } %>
    </p>
    <% } %>
  </div>

  <div class="inv-foot">
    <p>Thank you for shopping with <%= (settings && settings.legalName) || 'OceanBazar' %>.</p>
    <p>Questions? <%= supportEmail %> · <%= supportPhone %> · Computer-generated invoice</p>
  </div>
</div>

<script>
(function () {
  // A4 printable box at 96dpi with 8mm margins.
  var PRINT_WIDTH_PX = Math.round(((210 - 16) / 25.4) * 96);
  var PRINT_HEIGHT_PX = Math.round(((297 - 16) / 25.4) * 96);

  // Measure at the print width (not the phone/tablet width) so one invoice always
  // fits one page on every device, then shrink to fit if it would overflow.
  function fitToOnePage() {
    var el = document.getElementById('ob-invoice');
    if (!el) return;
    var prevWidth = el.style.width;
    el.style.setProperty('--print-scale', '1');
    el.style.width = PRINT_WIDTH_PX + 'px';
    var contentHeight = el.scrollHeight;
    el.style.width = prevWidth;
    var scale = contentHeight > PRINT_HEIGHT_PX ? PRINT_HEIGHT_PX / contentHeight : 1;
    el.style.setProperty('--print-scale', String(Math.max(0.45, Math.min(1, scale))));
  }

  fitToOnePage();
  window.addEventListener('resize', fitToOnePage);
  if (window.matchMedia) {
    try {
      window.matchMedia('print').addEventListener('change', fitToOnePage);
    } catch (e) { /* older browsers fall back to beforeprint */ }
  }
  window.addEventListener('beforeprint', fitToOnePage);

  var printBtn = document.getElementById('invoicePrintBtn');
  if (printBtn) {
    printBtn.addEventListener('click', function () {
      fitToOnePage();
      try { window.print(); } catch (e3) {}
    });
  }

  if (/[?&]autoprint=1/.test(location.search || '')) {
    setTimeout(function () {
      fitToOnePage();
      try { window.print(); } catch (e2) {}
    }, 400);
  }
})();
</script>

<%- include('partials/footer') %>
