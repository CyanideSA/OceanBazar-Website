<%- include('partials/head') %>

<%
  var items = order.items || order.orderItems || [];
  var paid = String(order.paymentStatus || '').toLowerCase() === 'paid'
    || String(order.paymentStatus || '').toLowerCase() === 'completed'
    || String(order.paymentStatus || '').toLowerCase() === 'success';
  var created = order.createdAt || order.created_at;
  var addr = order.shippingAddress || order.address || null;
  var cust = order.customer || {};
  var billName = cust.name || (addr && addr.name) || 'Customer';
  var billEmail = cust.email || '';
  var billPhone = cust.phone || (addr && addr.phone) || '';
  var num = function (v) { return Number(v || 0); };
  var logo = (settings && (settings.logoLightUrl || settings.logoDarkUrl))
    ? (settings.logoLightUrl || settings.logoDarkUrl)
    : (basePath + '/ob-brand-logo.png?v=8');
  function pretty(v) {
    var s = String(v || '').trim().toLowerCase().replace(/_/g, ' ');
    if (!s) return '—';
    return s.replace(/\b\w/g, function (c) { return c.toUpperCase(); });
  }
%>

<style>
  @media print {
    .site-header, .drawer, .nav-drawer, .nav-backdrop, .site-footer, .flash-bar, .no-print, #menuBtn, .bottom-nav { display: none !important; }
    html, body { background: #fff !important; margin: 0 !important; padding: 0 !important; height: auto !important; min-height: 0 !important; }
    body * { visibility: hidden !important; }
    #ob-invoice, #ob-invoice * { visibility: visible !important; }
    #ob-invoice { position: absolute !important; left: 0; top: 0; width: 100%; margin: 0; padding: 0; font-size: 10.5px; line-height: 1.35; }
    #ob-invoice table { font-size: 10px; }
    #ob-invoice img { height: 36px; width: auto; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
  @page { size: A4; margin: 8mm; }
  .invoice-toolbar { display: flex; justify-content: flex-end; gap: 10px; padding: 12px 16px; background: #f9fafb; border-bottom: 1px solid #e5e7eb; }
  #ob-invoice { max-width: 720px; margin: 0 auto; padding: 28px 24px; background: #fff; color: #1f2937; font-family: system-ui, sans-serif; }
  .inv-head { display: flex; justify-content: space-between; gap: 16px; border-bottom: 1px solid #e5e7eb; padding-bottom: 14px; }
  .inv-logo { height: 48px; width: auto; object-fit: contain; }
  .inv-meta { text-align: right; }
  .inv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px; }
  .inv-label { font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #9ca3af; }
  .inv-table { width: 100%; border-collapse: collapse; margin-top: 18px; font-size: 13px; }
  .inv-table th { background: #2E7CF6; color: #fff; padding: 8px 10px; text-align: left; }
  .inv-table th:nth-child(2) { text-align: center; }
  .inv-table th:nth-child(3), .inv-table th:nth-child(4) { text-align: right; }
  .inv-table td { padding: 6px 10px; border-bottom: 1px solid #f3f4f6; }
  .inv-table tr:nth-child(even) { background: #f9fafb; }
  .inv-totals { margin-top: 14px; margin-left: auto; width: 240px; font-size: 13px; }
  .inv-totals div { display: flex; justify-content: space-between; padding: 3px 0; color: #4b5563; }
  .inv-totals .grand { border-top: 1px solid #d1d5db; margin-top: 6px; padding-top: 8px; font-weight: 700; color: #111827; font-size: 15px; }
  .inv-totals .grand span:last-child { color: #2E7CF6; }
  .inv-foot { margin-top: 22px; border-top: 1px solid #e5e7eb; padding-top: 12px; text-align: center; font-size: 11px; color: #9ca3af; }
  .pill-inv { display: inline-block; border-radius: 999px; padding: 2px 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; }
  .pill-paid { background: #dcfce7; color: #15803d; }
  .pill-pend { background: #fef3c7; color: #92400e; }
  .pill-status { background: rgba(46,124,246,.12); color: #2E7CF6; }
</style>

<div class="invoice-toolbar no-print">
  <button type="button" class="btn btn-primary btn-sm" onclick="window.print()"><%= t('printInvoice') %></button>
  <a class="btn btn-outline btn-sm" href="<%= basePath %>/<%= locale %>/account/orders/<%= order.id %>">&larr; <%= t('orders') %></a>
</div>

<div id="ob-invoice">
  <div class="inv-head">
    <div>
      <img class="inv-logo" src="<%= logo %>" alt="OceanBazar" width="168" height="56" />
      <p class="muted" style="margin:8px 0 0;font-size:12px;">oceanbazar.com.bd</p>
      <p class="muted" style="margin:0;font-size:12px;">contact@oceanbazar.com.bd</p>
    </div>
    <div class="inv-meta">
      <h1 style="margin:0;font-size:22px;letter-spacing:.04em;"><%= t('invoice') %></h1>
      <p style="margin:6px 0 0;font-weight:600;">#<%= order.orderNumber || order.id %></p>
      <% if (created) { %>
      <p class="muted" style="margin:4px 0 0;font-size:12px;"><%= t('orderDate') %>: <%= new Date(created).toLocaleDateString(locale === 'bn' ? 'bn-BD' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
      <% } %>
      <p style="margin:8px 0 0;">
        <span class="pill-inv <%= paid ? 'pill-paid' : 'pill-pend' %>"><%= paid ? t('paid') : pretty(order.paymentStatus) %></span>
        <span class="pill-inv pill-status"><%= pretty(order.status) %></span>
      </p>
    </div>
  </div>

  <div class="inv-grid">
    <div>
      <p class="inv-label"><%= t('billTo') %></p>
      <p style="margin:6px 0 0;font-weight:600;"><%= billName %></p>
      <% if (billEmail) { %><p style="margin:2px 0;font-size:13px;"><%= billEmail %></p><% } %>
      <% if (billPhone) { %><p style="margin:2px 0;font-size:13px;"><%= billPhone %></p><% } %>
      <% if (addr) { %>
      <p style="margin:8px 0 0;font-size:13px;"><%= addr.addressLine1 || addr.addressLine || '' %></p>
      <p style="margin:2px 0;font-size:13px;"><%= [addr.city, addr.district].filter(Boolean).join(', ') %></p>
      <% if (addr.country) { %><p style="margin:2px 0;font-size:13px;"><%= addr.country %></p><% } %>
      <% } %>
    </div>
    <div>
      <p class="inv-label"><%= t('paymentMethod') %></p>
      <p style="margin:6px 0 0;font-weight:600;"><%= pretty(order.paymentMethod) %></p>
      <p class="inv-label" style="margin-top:12px;"><%= t('paymentStatus') %></p>
      <p style="margin:6px 0 0;font-weight:600;"><%= pretty(order.paymentStatus) %></p>
    </div>
  </div>

  <% if (items.length) { %>
  <table class="inv-table">
    <thead>
      <tr>
        <th><%= t('product') || 'Product' %></th>
        <th style="text-align:center;">Qty</th>
        <th style="text-align:right;">Unit</th>
        <th style="text-align:right;"><%= t('total') %></th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function (it) {
        var nm = it.productTitle || it.productName || it.name || it.productId;
        var vlabel = it.variantLabel || it.variant_label || '';
        var qty = num(it.quantity || 1);
        var unit = num(it.unitPrice != null ? it.unitPrice : it.price);
        var line = num(it.lineTotal != null ? it.lineTotal : unit * qty);
      %>
      <tr>
        <td>
          <%= nm %>
          <% if (vlabel) { %><div style="font-size:12px;color:#64748b;margin-top:2px;"><%= vlabel %></div><% } %>
        </td>
        <td style="text-align:center;"><%= qty %></td>
        <td style="text-align:right;"><%= helpers.money(unit) %></td>
        <td style="text-align:right;font-weight:600;"><%= helpers.money(line) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>

  <div class="inv-totals">
    <div><span><%= t('subtotal') %></span><span><%= helpers.money(order.subtotal || 0) %></span></div>
    <% if (num(order.discount) > 0) { %><div style="color:#16a34a;"><span><%= t('discount') %></span><span>-<%= helpers.money(order.discount) %></span></div><% } %>
    <div><span><%= t('shipping') %></span><span><%= num(order.shippingFee) === 0 ? t('trustShip') : helpers.money(order.shippingFee) %></span></div>
    <% if (num(order.gst) > 0) { %><div><span><%= t('vat') %></span><span><%= helpers.money(order.gst) %></span></div><% } %>
    <% if (num(order.serviceFee) > 0) { %><div><span><%= t('serviceFee') %></span><span><%= helpers.money(order.serviceFee) %></span></div><% } %>
    <div class="grand"><span><%= t('total') %></span><span><%= helpers.money(order.total || order.grandTotal || 0) %></span></div>
  </div>

  <div class="inv-foot">
    <p>Thank you for shopping with OceanBazar.</p>
    <p>Questions? contact@oceanbazar.com.bd · Computer-generated invoice</p>
  </div>
</div>

<script>
(function () {
  // #region agent log
  try {
    var el = document.getElementById('ob-invoice');
    var h = el ? el.scrollHeight : 0;
    fetch('http://127.0.0.1:7896/ingest/89e60d83-694f-49b3-8a65-19c43e3fa97c',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'1eb282'},body:JSON.stringify({sessionId:'1eb282',runId:'pre-fix',hypothesisId:'H1',location:'invoice.ejs',message:'lite invoice loaded',data:{scrollHeight:h,bodyScroll:document.body.scrollHeight,itemCount:<%= items.length %>},timestamp:Date.now()})}).catch(function(){});
  } catch (e) {}
  // #endregion
  if (/[?&]autoprint=1/.test(location.search || '')) {
    setTimeout(function () { try { window.print(); } catch (e2) {} }, 400);
  }
})();
</script>

<%- include('partials/footer') %>
