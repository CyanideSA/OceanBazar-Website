# OceanBazar ML service configuration

# SQLAlchemy URL to the shared Postgres (note port 5433 in local docker-compose).
DATABASE_URL=postgresql+psycopg2://oceanbazar:secret@localhost:5433/oceanbazar

# Shared secret required by the BFF in the X-ML-API-Key header. Leave empty to disable auth (dev only).
ML_SERVICE_API_KEY=change-me-ml-key

# OpenAI for marketing + SEO generation. Leave empty to use deterministic templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MODEL_VERSION=ob-os-1.0
PORT=8100
LOG_LEVEL=info
