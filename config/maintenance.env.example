# Copy to config/maintenance.env and run: node scripts/sync-maintenance-env.mjs
# NEVER commit config/maintenance.env (contains bypass secret).

MAINTENANCE_MODE=true
MAINTENANCE_BYPASS_TOKEN=REPLACE_WITH_openssl_rand_hex_32
MAINTENANCE_RETRY_AFTER=3600
MAINTENANCE_COOKIE_DOMAIN=.oceanbazar.com.bd
MAINTENANCE_ALLOW_HEALTH_PROBE=true

VITE_MAINTENANCE_MODE=true
VITE_MAINTENANCE_BYPASS_TOKEN=REPLACE_WITH_openssl_rand_hex_32
VITE_MAINTENANCE_COOKIE_DOMAIN=.oceanbazar.com.bd
VITE_MAINTENANCE_PAGE_URL=https://oceanbazar.com.bd/en/maintenance
