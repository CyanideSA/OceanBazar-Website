# Storefront environment variables
# Copy to .env.local and fill in the values

# Node.js BFF API URL (browser-visible). Local: loopback. AWS: https://api.example.com or CloudFront /api proxy URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Vite admin CRM URL (embedded /en|bn/admin routes redirect here)
NEXT_PUBLIC_ADMIN_CRM_URL=http://127.0.0.1:5173

# Realtime uses BFF Socket.IO (same origin as API) — do not point at Java
# NEXT_PUBLIC_WS_URL is deprecated; use NEXT_PUBLIC_API_URL only

# Public site URL (canonical storefront origin — metadata, OG tags).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Customer-facing live chat is disabled unless explicitly enabled.
NEXT_PUBLIC_LIVE_CHAT_ENABLED=true

# ─── Production maintenance lock (503 on all public routes) ───────────────────
# MAINTENANCE_MODE=true
# MAINTENANCE_BYPASS_TOKEN=change_me_long_random_secret_min_32_chars
# MAINTENANCE_RETRY_AFTER=3600
# Share cookie across storefront + admin: MAINTENANCE_COOKIE_DOMAIN=.oceanbazar.com.bd
# Staff unlock: https://oceanbazar.com.bd/en?bypass=YOUR_TOKEN (sets httpOnly cookie 14d)
# API testing: header x-maintenance-bypass: YOUR_TOKEN
# MAINTENANCE_ALLOW_HEALTH_PROBE=true

# Firebase Auth (client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Meta Pixel (browser-visible numeric pixel ID; never put an app secret here)
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id

# Sentry (optional — enables @sentry/nextjs wrapper + client/server SDK)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=0.1
# SENTRY_AUTH_TOKEN=  # CI: upload source maps
# SENTRY_ORG=your-org
# SENTRY_PROJECT=oceanbazar-web

# CSP: report-only by default; set enforce when clean. See docs/CSP_INVENTORY.md
# CSP_MODE=report-only
# CSP_MODE=enforce
# CSP_UPGRADE_INSECURE=true
# NEXT_PUBLIC_CSP_EXTRA_CONNECT_SRC=https://example.com

# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# reCAPTCHA Enterprise (site key is public; API key stays on the server only)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeXgl0tAAAAAJP4H-8VX2gfrkDJn3Y5QW26ioUF
