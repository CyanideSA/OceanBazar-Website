FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache curl

COPY package*.json ./
RUN npm ci

ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

EXPOSE 3000

# Bind-mount overlays ./frontend; node_modules + .next use compose named volumes.
# Install deps on first run when those volumes are empty.
CMD ["sh", "-c", "if [ ! -d node_modules/next ]; then npm ci; fi; exec npm run dev"]
