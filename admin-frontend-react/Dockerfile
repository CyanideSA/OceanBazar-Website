FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm install

COPY . .

ARG VITE_ADMIN_API_URL=
ARG VITE_ADMIN_API_SAME_ORIGIN=true
ARG VITE_MAINTENANCE_MODE=false
ARG VITE_MAINTENANCE_BYPASS_TOKEN=
ARG VITE_MAINTENANCE_COOKIE_DOMAIN=
ARG VITE_MAINTENANCE_PAGE_URL=https://oceanbazar.com.bd/en/maintenance
ENV VITE_ADMIN_API_URL=${VITE_ADMIN_API_URL}
ENV VITE_ADMIN_API_SAME_ORIGIN=${VITE_ADMIN_API_SAME_ORIGIN}
ENV VITE_MAINTENANCE_MODE=${VITE_MAINTENANCE_MODE}
ENV VITE_MAINTENANCE_BYPASS_TOKEN=${VITE_MAINTENANCE_BYPASS_TOKEN}
ENV VITE_MAINTENANCE_COOKIE_DOMAIN=${VITE_MAINTENANCE_COOKIE_DOMAIN}
ENV VITE_MAINTENANCE_PAGE_URL=${VITE_MAINTENANCE_PAGE_URL}

RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev

COPY --from=builder /app/dist ./dist
COPY server.mjs ./server.mjs

ENV ADMIN_BFF_PROXY_TARGET=http://api:4000
ENV PORT=5173

EXPOSE 5173
CMD ["node", "server.mjs"]
