# Admin CRM environment variables
# Copy to .env.local and fill in the values

# BFF API base URL (Node.js BFF that proxies to Java). Production: https://api.yourdomain.com (same origin as browser calls).
VITE_ADMIN_API_URL=http://127.0.0.1:4000

# Java WebSocket URL (STOMP/SockJS for catalog sync)
VITE_WS_URL=http://127.0.0.1:8000

# Storefront public URL (preview links from CRM). Production: https://oceanbazar.com.bd
VITE_STOREFRONT_URL=http://127.0.0.1:3000

# Maintenance lock — must match storefront/BFF MAINTENANCE_MODE + MAINTENANCE_BYPASS_TOKEN
# VITE_MAINTENANCE_MODE=true
# VITE_MAINTENANCE_BYPASS_TOKEN=change_me_long_random_secret_min_32_chars
# VITE_MAINTENANCE_COOKIE_DOMAIN=.oceanbazar.com.bd
# VITE_MAINTENANCE_PAGE_URL=https://oceanbazar.com.bd/en/maintenance
