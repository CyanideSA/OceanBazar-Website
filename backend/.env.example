# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
# Vite admin dashboard (admin-frontend-react); must match the origin in the browser
ADMIN_URL=http://localhost:5173

# Production / ECS behind CloudFront: comma-separated browser origins (must match exact scheme+host+port).
# Example: https://oceanbazar.com.bd,https://www.oceanbazar.com.bd,https://admin.oceanbazar.com.bd
CORS_ALLOWED_ORIGINS=

# Set to 1 when running behind AWS ALB or another trusted reverse proxy (correct req.ip, cookies, redirects).
TRUST_PROXY=

# Optional: comma-separated IPs (or prefix with trailing * e.g. 203.0.113.*) for /api/admin.
# Trust X-Forwarded-For only from your edge. Example:
# ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.22

# ─── Spring Boot Core API (proxied routes) ──────────────────────────────────
JAVA_API_URL=https://localhost:8000

# ─── Database ────────────────────────────────────────────────────────────────
# Production (Neon):
# DATABASE_URL="postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_POOLER_HOST>/<NEON_DB>?sslmode=require"
# Local Docker Compose (host port 5433):
# DATABASE_URL="postgresql://oceanbazar:secret@127.0.0.1:5433/oceanbazar?schema=public"
DATABASE_URL="postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_POOLER_HOST>/<NEON_DB>?sslmode=require"

# Background workers (BFF runtime). Set to "false" to disable.
# ANALYTICS_CRON=true
# EVENT_DLQ_CRON=true
# DLQ_WORKER=true
# EVENT_DLQ_POLL_MS=300000
# EVENT_DLQ_BATCH=25
# ANALYTICS_NIGHTLY_HOUR=2

# ─── Redis ───────────────────────────────────────────────────────────────────
# Optional for free deployment (can be omitted; app degrades gracefully)
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Observability (optional) ─────────────────────────────────────────────────
# Sentry (BFF) — disables standalone OTLP HTTP instrumentation when set (use Sentry tracing)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry OTLP (BFF) — base URL only; /v1/traces appended. Omit if using SENTRY_DSN.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=oceanbazar-bff

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
# Set to "true" to only print OTP to terminal. Keep false when a provider is configured.
OTP_TERMINAL_ONLY=false

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
EMAIL_FROM="Oceanbazar <noreply@oceanbazar.com>"

# ─── SMS / WhatsApp OTP ─────────────────────────────────────────────────────
# Twilio is preferred for SMS. If it is not configured, OTP delivery falls back
# to the WhatsApp Cloud API configuration below.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ─── Social OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/social/google/callback

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/social/facebook/callback

INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_CALLBACK_URL=http://localhost:4000/api/auth/social/instagram/callback

# ─── Payments ────────────────────────────────────────────────────────────────
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_KEY=your_nagad_merchant_key
NAGAD_BASE_URL=https://sandbox.mynagad.com:10080/remote-payment-gateway-1.0

SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_SANDBOX=true
# Public SSLCommerz sandbox for local testing: store_id=testbox, password=qwerty
# Docker BFF host port is 4001 — payment callbacks must use API_BASE_URL=http://127.0.0.1:4001
API_BASE_URL=http://127.0.0.1:4001

# ─── Admin Catalog Studio (file-import scan default) ─────────────────────────
# Windows path to folder tree: Category / Subcategory / Product / media files
ADMIN_STUDIO_ROOT=C:\Users\akand\Desktop\All Categories (Demo)

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
PUBLIC_BASE_URL=https://localhost:8000

