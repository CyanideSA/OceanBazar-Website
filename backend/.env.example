# ─── Admin CRM SSO (Microsoft 365 / Entra ID + optional Google Workspace) ────
# Required for the Admin CRM "Sign in with Microsoft 365" screen:
#   1. Create (or reuse) an Entra ID app registration with delegated OIDC.
#   2. Add redirect URI exactly matching MS_SSO_REDIRECT_URI below.
#   3. Grant delegated scopes: openid, profile, email, User.Read.
#   4. Set ADMIN_URL to the CRM origin (Vite: http://localhost:5173).
#   5. REDIS_URL must be set (SSO PKCE state + handoff codes live in Redis).
#   6. Provision each admin in CRM Team & Permissions with their M365 email first
#      (SSO does not auto-create accounts; unmatched emails → not_provisioned).
# MS_TENANT_ID=              # Same tenant as Graph (see Microsoft 365 Graph section)
# MS_SSO_CLIENT_ID=          # Separate app registration (delegated OIDC) recommended
# MS_SSO_CLIENT_SECRET=
# MS_SSO_REDIRECT_URI=http://localhost:4401/api/admin/auth/sso/microsoft/callback
# ADMIN_SSO_ALLOWED_DOMAINS=oceanbazar.com.bd,oceanbazar.com
# ADMIN_URL=http://localhost:5173
# ADMIN_GOOGLE_CLIENT_ID=
# ADMIN_GOOGLE_CLIENT_SECRET=
# ADMIN_GOOGLE_REDIRECT_URI=http://localhost:4000/api/admin/auth/sso/google/callback
# ADMIN_GOOGLE_HOSTED_DOMAIN=oceanbazar.com.bd

# ─── Content ID tool (contentid.oceanbazar.com.bd) ───────────────────────────
# CONTENT_ID_APP_URL=http://localhost:5180
# MS_CONTENT_ID_REDIRECT_URI=http://localhost:4000/api/content-id/auth/sso/microsoft/callback
# Production example:
# CONTENT_ID_APP_URL=https://contentid.oceanbazar.com.bd
# MS_CONTENT_ID_REDIRECT_URI=https://api.oceanbazar.com.bd/api/content-id/auth/sso/microsoft/callback

